{
    "name": "nswdpc/silverstripe-asset-scan",
    "description": "Provides an asset store and a scanning backend for Silverstripe assets",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "assets",
        "file scan",
        "upload",
        "clamav",
        "clam"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "xenolope/quahog": "^3",
        "silverstripe/assets": "^3"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "cambis/silverstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2",
        "nswdpc/ci-files": "dev-v-4",
        "vlucas/phpdotenv": "^5"
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\AssetScan\\": [
                "src/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
